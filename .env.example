# Copy to .env (never commit it) and fill in.
# Both tokens come from the Slack app's settings page.

# App-level token with connections:write (Basic Information > App-Level Tokens)
HUBOT_SLACK_APP_TOKEN=xapp-...
# Bot User OAuth Token (OAuth & Permissions)
HUBOT_SLACK_BOT_TOKEN=xoxb-...

# Optional
# HUBOT_LOG_LEVEL=info
# HUBOT_CODE_OF_CONDUCT_FILE=/app/code_of_conduct.md
